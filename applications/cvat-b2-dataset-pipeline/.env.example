# Copy to .env, chmod 600 .env. Never commit .env.
# Use a bucket-scoped application key, not the master key.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
# Region of the bucket, e.g. the "s3.<region>.backblazeb2.com" part of its endpoint.
B2_REGION=
# Optional override; derived from B2_REGION when empty.
B2_ENDPOINT=
